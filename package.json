{
  "name": "shanhe-cards",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx tools/content-check.ts",
    "test": "vitest run --configLoader native",
    "test:browser": "playwright test",
    "build": "npm run typecheck && npm run content:check && npm test && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "start": "node tools/serve.mjs",
    "test:performance": "tsx tools/benchmark.ts",
    "test:mortal-performance": "tsx tools/mortal-benchmark.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
